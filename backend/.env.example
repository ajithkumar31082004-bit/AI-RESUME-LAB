# ==========================================
# AI RESUME LAB — Environment Configuration
# ==========================================

# Application Settings
FLASK_ENV=development
DEBUG=True
SECRET_KEY=generate-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=generate-a-secure-jwt-secret-key-in-production

# Database (Development: SQLite, Production: PostgreSQL)
DATABASE_URL=sqlite:///db/resume_lab.db
# DATABASE_URL=postgresql://resume_user:your_password@localhost:5432/resume_lab_db

# File Storage
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880

# AWS S3 Storage (Optional: if omitted, resumes are stored locally in uploads/)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=ai-resume-lab-storage
S3_BUCKET_URL=https://ai-resume-lab-storage.s3.amazonaws.com

# AI / LLM Integration (Optional: fallback deterministic engine is used if empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7

# Allowed Origins for CORS (Frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://ai-resume-lab-static.s3-website-us-east-1.amazonaws.com
